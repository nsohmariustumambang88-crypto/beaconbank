// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User/Client Model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  phone         String?
  profileImage  String?
  accountType   String    @default("personal") // personal, business, premium
  kycStatus     String    @default("pending") // pending, verified, rejected
  amlVerified   Boolean   @default(false)

  // Relationships
  wallets       Wallet[]
  transactions  Transaction[]
  transfers     Transfer[]
  refunds       Refund[]
  recoveries    FundRecovery[]
  marketplace   MarketplaceStore?
  securityLogs  SecurityLog[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Digital Wallet Model
model Wallet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency      String    @default("USD") // USD, EUR, GBP, etc.
  balance       Decimal   @default(0) @db.Decimal(18, 2)
  accountNumber String    @unique
  routingNumber String?
  iban          String?
  swiftCode     String?

  // Relationships
  transactions  Transaction[]
  transfers     Transfer[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, currency])
}

// Transaction Model (deposits, withdrawals, etc.)
model Transaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId      String
  wallet        Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type          String    // deposit, withdrawal, transfer_in, transfer_out, refund_in, refund_out
  amount        Decimal   @db.Decimal(18, 2)
  currency      String
  status        String    @default("pending") // pending, completed, failed, cancelled
  description   String?
  referenceId   String?

  // Metadata
  metadata      Json?
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Transfer Model
model Transfer {
  id                String    @id @default(cuid())
  senderId          String
  sender            User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderWalletId    String
  senderWallet      Wallet    @relation("SenderTransfers", fields: [senderWalletId], references: [id])

  recipientEmail    String
  recipientWallet   String?
  amount            Decimal   @db.Decimal(18, 2)
  currency          String    @default("USD")
  exchangeRate      Decimal?  @db.Decimal(10, 6)
  convertedAmount   Decimal?  @db.Decimal(18, 2)
  fee               Decimal   @default(0) @db.Decimal(10, 2)

  status            String    @default("pending") // pending, processing, completed, failed, cancelled
  settlementTime    DateTime?
  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Refund Model
model Refund {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalOrderId   String
  merchantId        String?
  amount            Decimal   @db.Decimal(18, 2)
  currency          String
  status            String    @default("pending") // pending, approved, processing, completed, rejected
  reason            String

  refundType        String    // full, partial, store_credit, scheduled
  scheduledDate     DateTime?

  approvalDate      DateTime?
  completionDate    DateTime?

  notes             String?
  metadata          Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Fund Recovery Model
model FundRecovery {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  caseNumber        String    @unique
  fraudType         String    // unauthorized_transaction, phishing, identity_theft, etc.
  amount            Decimal   @db.Decimal(18, 2)
  currency          String

  status            String    @default("open") // open, investigating, recovered, closed, rejected
  severity          String    @default("medium") // low, medium, high, critical

  description       String
  evidence          String[]  // URLs or file references

  assignedInvestigator String?
  investigationNotes String?

  recoveredAmount   Decimal?  @db.Decimal(18, 2)
  recoveryDate      DateTime?

  caseOpenDate      DateTime  @default(now())
  caseCloseDate     DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Marketplace Store Model
model MarketplaceStore {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName         String
  storeSlug         String    @unique
  description       String?
  logo              String?

  status            String    @default("active") // active, inactive, suspended
  commissionRate    Decimal   @default(0) @db.Decimal(5, 2) // percentage
  totalSales        Decimal   @default(0) @db.Decimal(18, 2)

  // Relationships
  products          MarketplaceProduct[]
  orders            MarketplaceOrder[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Marketplace Product Model
model MarketplaceProduct {
  id                String    @id @default(cuid())
  storeId           String
  store             MarketplaceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  price             Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD")

  category          String
  sku               String?
  stock             Int       @default(0)

  images            String[]
  status            String    @default("active") // active, inactive, archived

  // Relationships
  orderItems        MarketplaceOrderItem[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Marketplace Order Model
model MarketplaceOrder {
  id                String    @id @default(cuid())
  storeId           String
  store             MarketplaceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderNumber       String    @unique
  buyerEmail        String

  totalAmount       Decimal   @db.Decimal(18, 2)
  currency          String    @default("USD")
  status            String    @default("pending") // pending, paid, processing, shipped, delivered, cancelled

  shippingAddress   String?
  shippingMethod    String?
  trackingNumber    String?

  // Relationships
  items             MarketplaceOrderItem[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Marketplace Order Item Model
model MarketplaceOrderItem {
  id                String    @id @default(cuid())
  orderId           String
  order             MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId         String
  product           MarketplaceProduct @relation(fields: [productId], references: [id])

  quantity          Int
  unitPrice         Decimal   @db.Decimal(12, 2)
  subtotal          Decimal   @db.Decimal(18, 2)

  createdAt         DateTime  @default(now())
}

// Security & Compliance Log Model
model SecurityLog {
  id                String    @id @default(cuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventType         String    // login, logout, failed_login, 2fa_enabled, 2fa_used, transaction_initiated, etc.
  ipAddress         String?
  userAgent         String?
  location          String?

  status            String    @default("success") // success, failure, suspicious
  riskScore         Int       @default(0) // 0-100

  details           Json?

  createdAt         DateTime  @default(now())
}

// Compliance Record Model
model ComplianceRecord {
  id                String    @id @default(cuid())

  recordType        String    // aml_check, kyc_verification, transaction_monitoring, audit
  status            String    @default("pending") // pending, approved, rejected, review

  documentUrl       String?
  verificationDate  DateTime?

  notes             String?
  metadata          Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// API Key Model (for third-party integrations)
model ApiKey {
  id                String    @id @default(cuid())
  name              String
  key               String    @unique
  secret            String

  status            String    @default("active") // active, inactive, revoked
  permissions       String[]  // array of permissions

  lastUsedAt        DateTime?
  expiresAt         DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
